<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bag2bag.st.mapper.TradeMapper">

    <resultMap id="TradeMap" type="com.bag2bag.st.entity.Trade">
        <id     column="id"          property="id"/>
        <result column="item_id"     property="itemId"/>
        <result column="buyer_id"    property="buyerId"/>
        <result column="seller_id"   property="sellerId"/>
        <result column="meet_time"   property="meetTime"/>
        <result column="meet_place"  property="meetPlace"/>
        <result column="price_cents" property="priceCents"/>
        <result column="trade_item"  property="tradeItem"/>
        <result column="status"      property="status"/>
        <result column="buyer_ok"    property="buyerOk"/>
        <result column="seller_ok"   property="sellerOk"/>
        <result column="locked"      property="locked"/>
        <result column="version"     property="version"/>
        <result column="created_at"  property="createdAt"/>
        <result column="updated_at"  property="updatedAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.bag2bag.st.entity.Trade" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sh_trade
        (item_id,buyer_id,seller_id,meet_time,meet_place,price_cents,trade_item,status,buyer_ok,seller_ok,locked,version)
        VALUES
            (#{itemId},#{buyerId},#{sellerId},#{meetTime},#{meetPlace},#{priceCents},#{tradeItem},#{status},#{buyerOk},#{sellerOk},#{locked},#{version})
    </insert>

    <select id="selectById" resultMap="TradeMap">
        SELECT id,item_id,buyer_id,seller_id,meet_time,meet_place,price_cents,trade_item,status,
               buyer_ok,seller_ok,locked,version,created_at,updated_at
        FROM sh_trade WHERE id=#{id}
    </select>

    <!-- 賣家接受：0 -> 2 + locked=1 -->
    <update id="acceptToPending">
        UPDATE sh_trade
        SET status=2, locked=1, version=version+1
        WHERE id=#{id} AND status=0 AND version=#{expectVersion}
    </update>

    <!-- 賣家拒絕：0 -> 4 -->
    <update id="decline">
        UPDATE sh_trade
        SET status=4, version=version+1
        WHERE id=#{id} AND status=0 AND version=#{expectVersion}
    </update>

    <!-- 買家確認：2 -> (2/3) -->
    <update id="markBuyerConfirmed">
        UPDATE sh_trade
        SET buyer_ok=1,
            status=CASE WHEN seller_ok=1 THEN 3 ELSE 2 END,
            version=version+1
        WHERE id=#{id} AND status=2 AND version=#{expectVersion}
    </update>

    <!-- 賣家確認：2 -> (2/3) -->
    <update id="markSellerConfirmed">
        UPDATE sh_trade
        SET seller_ok=1,
            status=CASE WHEN buyer_ok=1 THEN 3 ELSE 2 END,
            version=version+1
        WHERE id=#{id} AND status=2 AND version=#{expectVersion}
    </update>

</mapper>
